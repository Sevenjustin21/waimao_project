#####################################################################
# Core application URLs & modes
#####################################################################
APP_ENV=development                 # deployment stage flag used by next.config.js
NEXT_PUBLIC_APP_ENV=development     # exposed to browser for UI toggles (mirror APP_ENV)
APP_URL=http://localhost:3000       # canonical base URL for server-side links (Next.js)
NEXTAUTH_URL=http://localhost:3000  # NextAuth callback URL (must be HTTPS in production)
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055  # Directus API origin for browser requests
NEXT_PUBLIC_ASSET_BASE_URL=/api/assets          # Asset proxy prefix or CDN URL
REDIS_PASSWORD=replace-with-redis-password      # shared password for redis service

#####################################################################
# Authentication & Database
#####################################################################
NEXTAUTH_SECRET=replace-with-strong-random-string  # 32+ char secret for NextAuth session encryption
AUTH_SECRET=replace-with-legacy-secret             # (optional) legacy auth secret if referenced elsewhere
DATABASE_URL=postgresql://directus:directus@localhost:15432/directus?schema=app_auth  # Prisma connection string
COOKIE_SECURE=false                                # set true in HTTPS prod to force secure cookies

#####################################################################
# Postgres / Directus runtime (docker-compose + Directus envs)
#####################################################################
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus
POSTGRES_DB=directus
DIRECTUS_URL=http://localhost:8055              # Used by scripts + Next.js server handlers
DIRECTUS_KEY=replace-with-directus-app-key      # Directus APP_KEY
DIRECTUS_SECRET=replace-with-directus-app-secret  # Directus APP_SECRET
DIRECTUS_ADMIN_EMAIL=admin@example.com          # Bootstrap admin account (only for first run)
DIRECTUS_ADMIN_PASSWORD=change-me              # Bootstrap admin password (only for first run)
DIRECTUS_ADMIN_TOKEN=replace-with-directus-static-admin-token  # Used by scripts/server-side requests
DIRECTUS_WEBHOOK_SECRET=replace-with-webhook-secret             # Shared secret for Directus -> Next webhooks

#####################################################################
# Search / Meilisearch
#####################################################################
MEILISEARCH_HOST=http://localhost:17700
MEILI_MASTER_KEY=change-me                    # main API key used by scripts/server to manage indexes
MEILISEARCH_MASTER_KEY=change-me              # fallback alias (if Directus sync expects this env)

#####################################################################
# Cache / Rate limiting
#####################################################################
UPSTASH_REDIS_REST_URL=                      # optional distributed limiter endpoint
UPSTASH_REDIS_REST_TOKEN=                    # optional Upstash token
REDIS_URL=redis://:replace-with-redis-password@localhost:16379            # used by app if direct Redis connection is required

#####################################################################
# Admin helper secrets
#####################################################################
ADMIN_API_SECRET=replace-with-admin-api-secret        # protects /api/reindex & other admin-only routes
ADMIN_BOOTSTRAP_EMAIL=admin@waimao.com                # optional script to create seeded admin user
ADMIN_BOOTSTRAP_PASSWORD=change-me                    # password for seeded admin
TEST_BASE_URL=http://localhost:3000                   # scripts/test-admin-flow.ts reference

#####################################################################
# Email / RFQ notifications
#####################################################################
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM_NAME=Waimao System
SMTP_FROM_EMAIL=rfq@example.com
SMTP_REPLY_TO=sales@example.com
NOTIFY_EMAIL_TO=sales@example.com
