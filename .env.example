#####################################################################
# Application URLs
#####################################################################
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
REDIS_PASSWORD=replace-with-redis-password

#####################################################################
# Authentication & Database (Prisma/NextAuth)
#####################################################################
NEXTAUTH_SECRET=replace-with-strong-random-string
AUTH_SECRET=replace-with-strong-random-string
DATABASE_URL=postgresql://directus:directus@localhost:15432/directus?schema=app_auth

#####################################################################
# Directus + Postgres (docker-compose + Directus client)
#####################################################################
POSTGRES_USER=directus
POSTGRES_PASSWORD=directus
POSTGRES_DB=directus
DIRECTUS_URL=http://localhost:8055
DIRECTUS_KEY=replace-with-directus-app-key
DIRECTUS_SECRET=replace-with-directus-app-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
DIRECTUS_ADMIN_TOKEN=CBgmk243fUANU_6OQBqKU1o7JN88-JbQ
DIRECTUS_WEBHOOK_SECRET=replace-with-webhook-secret

#####################################################################
# Search / Meilisearch
#####################################################################
MEILISEARCH_HOST=http://localhost:17700
MEILI_MASTER_KEY=change-me
MEILISEARCH_MASTER_KEY=change-me

#####################################################################
# Admin APIs & bootstrap helpers
#####################################################################
ADMIN_API_SECRET=replace-with-admin-api-secret
ADMIN_BOOTSTRAP_EMAIL=admin@waimao.com
ADMIN_BOOTSTRAP_PASSWORD=change-me

#####################################################################
# Email notifications for RFQ
#####################################################################
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM_NAME=Waimao System
SMTP_FROM_EMAIL=rfq@example.com
SMTP_REPLY_TO=sales@example.com
NOTIFY_EMAIL_TO=sales@example.com

#####################################################################
# Local Redis connection (optional, useful for dev/staging compose)
#####################################################################
REDIS_URL=redis://:replace-with-redis-password@localhost:16379

#####################################################################
# Distributed rate limiting (optional - Upstash Redis REST)
#####################################################################
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

#####################################################################
# Asset proxy (optional)
#####################################################################
NEXT_PUBLIC_ASSET_BASE_URL=/api/assets
