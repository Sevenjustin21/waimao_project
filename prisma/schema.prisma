// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model AppUser {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  lastLoginAt   DateTime?
  vipTitle      String?

  @@map("app_users")
}

model EmailSettings {
  id         Int       @id
  smtpHost   String?
  smtpPort   Int?
  smtpSecure Boolean   @default(false)
  smtpUser   String?
  smtpPass   String?
  fromName   String?
  fromEmail  String?
  notifyTo   String?
  replyTo    String?
  updatedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("email_settings")
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  fileId     String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("product_images")
  @@index([productId], map: "product_images_product_idx")
}
